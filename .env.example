# ============================================
# TranscreveZAP v3.0 — Variaveis de Ambiente
# ============================================
# Copie este arquivo para .env e ajuste os valores

# === Database ===
# SQLite (padrao — zero config, recomendado para comecar):
DATABASE_URL=file:/app/data/transcrevezap.db
# PostgreSQL (opcional, para producao com mais volume):
# DATABASE_URL=postgresql://transcrevezap:sua_senha@postgres:5432/transcrevezap

# === Redis (obrigatorio) ===
REDIS_HOST=redis-transcrevezap
REDIS_PORT=6380
REDIS_PASSWORD=
REDIS_DB=0

# === Autenticacao (obrigatorio) ===
# IMPORTANT: Gere uma chave aleatoria para producao!
# Exemplo: openssl rand -hex 32
BETTER_AUTH_SECRET=gere-uma-chave-secreta-aleatoria-aqui
BETTER_AUTH_URL=https://manager.seu.dominio.com

# === Admin Inicial (obrigatorio no primeiro deploy) ===
# Estas credenciais criam o usuario admin na primeira execucao.
# Altere a senha pelo painel depois do primeiro login.
ADMIN_EMAIL=admin@seu.email.com
ADMIN_PASSWORD=sua_senha_segura_aqui

# === URLs Publicas ===
# URL do painel (usada para callbacks de auth e OG tags)
NEXT_PUBLIC_APP_URL=https://manager.seu.dominio.com
# URL interna do NestJS (comunicacao Next.js -> NestJS dentro do container)
NESTJS_INTERNAL_URL=http://localhost:8005

# === Dominios (para Traefik) ===
API_DOMAIN=api.seu.dominio.com
MANAGER_DOMAIN=manager.seu.dominio.com

# === Portas ===
API_PORT=8005
WEB_PORT=3000

# === Seguranca (producao) ===
# Secret para proteger a API interna contra acessos externos.
# Se configurado, requisicoes externas precisam do header X-Internal-Secret.
# Deixe vazio para desenvolvimento local.
# INTERNAL_API_SECRET=

# === Traefik (opcional) ===
NETWORK_NAME=sua_rede_externa
SSL_RESOLVER=letsencryptresolver
SSL_ENTRYPOINT=websecure

# === Timezone ===
TZ=America/Sao_Paulo

# === Node ===
NODE_ENV=production

# ============================================
# API Keys dos Providers de IA
# ============================================
# NAO precisa definir aqui!
# Configure as API keys pelo painel: Configuracoes > API Keys
# Suporta: Groq, OpenAI, Google Gemini, Deepgram, OpenRouter
# ============================================
