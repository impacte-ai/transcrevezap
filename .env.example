# ============================================
# TranscreveZAP v3.0 — Variáveis de Ambiente
# ============================================

# === Database ===
# SQLite (padrão — zero config):
DATABASE_URL=file:/app/data/transcrevezap.db
# PostgreSQL (opcional):
# DATABASE_URL=postgresql://user:password@localhost:5432/transcrevezap

# === Redis ===
REDIS_HOST=redis-transcrevezap
REDIS_PORT=6380
REDIS_PASSWORD=
REDIS_DB=0

# === Auth ===
BETTER_AUTH_SECRET=gere-uma-chave-secreta-aleatoria-aqui
ADMIN_EMAIL=admin@transcrevezap.local
ADMIN_PASSWORD=admin123

# === Domínios (Traefik) ===
API_DOMAIN=api.seu.dominio.com
MANAGER_DOMAIN=manager.seu.dominio.com
NEXT_PUBLIC_APP_URL=https://manager.seu.dominio.com

# === Portas ===
API_PORT=8005
WEB_PORT=3000

# === NestJS Internal (Next.js → NestJS) ===
NESTJS_INTERNAL_URL=http://localhost:8005

# === Traefik (opcional) ===
NETWORK_NAME=sua_rede_externa
SSL_RESOLVER=letsencryptresolver
SSL_ENTRYPOINT=websecure

# === Debug ===
NODE_ENV=production
LOG_LEVEL=info

# === API Keys dos Providers (configurar no painel) ===
# Não precisa definir aqui — configure via Dashboard > Configurações
